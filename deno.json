{
  "compilerOptions": {
    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@1.0.14"
  },
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check mod.ts tables/*.ts src/*.ts programs/*/*.ts browser_e2e.ts static_jobs_native_fixture.ts",
    "test": "deno test --allow-read --allow-write tables/ src/"
  }
}
